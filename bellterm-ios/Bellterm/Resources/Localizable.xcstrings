    "First connection to %@. Check that its key fingerprint matches before trusting it:\n\n%@\n\nOn the host: ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "First connection to %1$@. Check that its key fingerprint matches before trusting it:\n\n%2$@\n\nOn the host: ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "首次连接 %1$@。信任前请核对密钥指纹：\n\n%2$@\n\n在主机上运行：ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub"
          }
        }
      }
    },
