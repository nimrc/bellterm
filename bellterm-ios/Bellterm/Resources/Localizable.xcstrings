{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ · %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@"
          }
        }
      }
    },
    "%@ (hop %lld)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ (hop %2$lld)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@（第 %2$lld 跳）"
          }
        }
      }
    },
    "%@ copy" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 副本"
          }
        }
      }
    },
    "%@ needs input" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 需要输入"
          }
        }
      }
    },
    "%@ presented a different key than the one you trusted. This can mean the host was reinstalled, or that someone is intercepting the connection. New fingerprint:\n\n%@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ presented a different key than the one you trusted. This can mean the host was reinstalled, or that someone is intercepting the connection. New fingerprint:\n\n%2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 出示的密钥与你之前信任的不同。可能是主机重装了系统，也可能有人在拦截连接。新指纹：\n\n%2$@"
          }
        }
      }
    },
    "%@ rejected the key. Check that its public key is in ~/.ssh/authorized_keys on the host." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 拒绝了密钥。请确认主机的 ~/.ssh/authorized_keys 中有这把公钥。"
          }
        }
      }
    },
    "%@ rejected the password. It may have changed; enter it again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 拒绝了密码。密码可能已更改，请重新输入。"
          }
        }
      }
    },
    "%lld" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld"
          }
        }
      }
    },
    "A key on this route could not be read. Check Keys & certificates." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "路由上的某把密钥无法读取，请检查“密钥与证书”。"
          }
        }
      }
    },
    "A password is saved. Type a new one to replace it." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已保存密码。输入新密码即可替换。"
          }
        }
      }
    },
    "A route may have at most %lld hops." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "路由最多 %lld 跳。"
          }
        }
      }
    },
    "Add a machine that runs Herdr, or import your ~/.ssh/config." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加一台运行 Herdr 的机器，或导入你的 ~/.ssh/config。"
          }
        }
      }
    },
    "Add key" : {
      "localizations" : {
        "zh-Hans" : {
