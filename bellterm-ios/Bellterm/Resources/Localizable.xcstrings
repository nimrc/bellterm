    "Add this line to ~/.ssh/authorized_keys on each host." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把这一行加入每台主机的 ~/.ssh/authorized_keys。"
