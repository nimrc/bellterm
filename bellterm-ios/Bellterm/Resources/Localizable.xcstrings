    "Bellterm connects to the jump host first and reaches this node through it, as ssh -J does. Jump hosts can have jump hosts of their own." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bellterm 先连接跳板机，再经由它到达本节点，与 ssh -J 相同。跳板机本身也可以再经过跳板机。"
          }
        }
      }
    },
    "Bellterm is too old" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请更新 Bellterm"
          }
        }
